# Local secrets and environment overrides
.env
.env.*
!.env.example

# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, linter, and coverage caches
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Python packaging output
build/
dist/
*.egg-info/

# Jupyter and generic local caches
.ipynb_checkpoints/
.cache/

# Raw and generated datasets. Keep lightweight metadata in Git.
/data/**
!/data/**/
!/data/**/*.md
!/data/**/MD5SUMS

# Downloaded CodonTransformer weights/tokenizer files; keep its code and docs.
/CodonTransformer/data/

# ProteinFolding: local ESM3 weights, result cache, downloaded samples, CLI output.
# The vendored Mol* build under frontend/vendor/ IS tracked (self-contained offline frontend).
/ProteinFolding/data/
/ProteinFolding/output/

# Model weights, checkpoints, and experiment output
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
pytorch_model*.bin
/artifacts/
/checkpoints/
/outputs/
/runs/
/wandb/
/mlruns/
/lightning_logs/
/flagged/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# Editors: retain shared VS Code project configuration
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
*.suo
*.user
*.userosscache
*.sln.docstates

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
