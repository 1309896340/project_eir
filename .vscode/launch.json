{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CodonTransformer 调试界面 (gradio :7860)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/CodonTransformer/codontransformer_app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "serverReadyAction": {
                "pattern": "running on local URL: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
